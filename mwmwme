<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <title>Growth OS | Permanent Complete Edition</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root { --bg: #FAF9F6; --text: #4A4540; --glass: rgba(255,255,255,0.7); }
        .theme-sunset { --bg: #F8F1ED; --text: #5D544C; --glass: rgba(235, 218, 208, 0.7); }
        .theme-night { --bg: #1A1C20; --text: #E5E7EB; --glass: rgba(45, 48, 55, 0.7); }
        body { font-family: 'Noto Sans TC', sans-serif; background-color: var(--bg); color: var(--text); transition: 0.8s; }
        .glass { background: var(--glass); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.2); }
        .page { display: none; padding-bottom: 150px; }
        .active { display: block; }
        .chk { width: 24px; height: 24px; border: 2px solid #8E7E6E; border-radius: 6px; appearance: none; cursor: pointer; }
        .chk:checked { background: #8E7E6E; }
    </style>
</head>
<body class="pt-10 px-6" id="appBody">

<div class="fixed top-6 right-6 z-[100] glass p-2 rounded-full flex gap-2 shadow-xl">
    <button onclick="setTheme('day')" class="w-8 h-8 flex items-center justify-center text-lg">☀️</button>
    <button onclick="setTheme('sunset')" class="w-8 h-8 flex items-center justify-center text-lg">🌇</button>
    <button onclick="setTheme('night')" class="w-8 h-8 flex items-center justify-center text-lg">⭐</button>
</div>

<div class="max-w-md mx-auto">
    <div id="p1" class="page active">
        <h1 class="text-4xl italic text-[#8E7E6E] mb-10 text-center font-serif">Ritual</h1>
        <div class="glass p-8 rounded-[40px] mb-8">
            <h2 class="text-xl font-bold border-b pb-4 mb-4">晨間校準儀式 (The 2-Minute Reset)</h2>
            <div class="space-y-6 text-sm">
                <div><b>1-2. 設定基調：</b>「今天會是美好的一天。」「今天會有酷的事情發生在我身上。」註：開啟大腦機會掃描器。</div>
                <div><b>3-4. 建立韌性：</b>「無論今天發生什麼，我都能應對。」「今天是我生命中令人興奮的新篇章。」註：對抗焦慮。</div>
                <div><b>5-6. 自我接納：</b>「對於自己的努力，我值得更多的肯定。」「我被允許成為一個『正在進步中』的人。」註：放下完美主義。</div>
                <div><b>7-8. 長期價值：</b>「只要我持續出現，生命就會回饋我。」「我對這個世界有著重要的貢獻。」註：確認存在意義。</div>
            </div>
        </div>
        <div class="glass p-8 rounded-[40px]">
            <h2 class="text-xl font-bold mb-4">⚡ 1 號人專屬儀式</h2>
            <ul class="list-disc pl-4 text-sm space-y-2">
                <li>晨起 30 分鐘內不碰手機，做自己的主人。</li>
                <li>透過爆汗運動釋放能量。</li>
                <li>單點突破，先輸出再輸入。</li>
            </ul>
        </div>
    </div>

    <div id="p2" class="page">
        <h1 class="text-4xl italic text-[#8E7E6E] mb-10 text-center font-serif">Path</h1>
        <div id="taskContainer" class="space-y-6"></div>
    </div>

    <div id="p3" class="page">
        <h1 class="text-4xl italic text-[#8E7E6E] mb-10 text-center font-serif">Journal</h1>
        <div class="glass p-8 rounded-[40px] mb-8">
            <textarea id="dInput" class="w-full h-32 bg-transparent outline-none mb-4" placeholder="記錄覺察與感恩..."></textarea>
            <input type="file" id="imgIn" class="hidden" accept="image/*">
            <button onclick="document.getElementById('imgIn').click()" class="text-xs uppercase mb-4 opacity-60">Add Image</button>
            <button onclick="saveD()" class="bg-[#8E7E6E] text-white px-8 py-2 rounded-full text-sm w-full">儲存紀錄</button>
        </div>
        <div id="dList" class="space-y-6"></div>
    </div>
</div>

<nav class="fixed bottom-8 left-6 right-6 flex justify-center z-50">
    <div class="glass rounded-[40px] px-8 py-4 flex gap-6 shadow-2xl">
        <button onclick="nav(0)" class="text-[10px] font-bold uppercase">Ritual / 儀式</button>
        <button onclick="nav(1)" class="text-[10px] font-bold uppercase">Path / 挑戰</button>
        <button onclick="nav(2)" class="text-[10px] font-bold uppercase">Journal / 手帳</button>
    </div>
</nav>

<script>
    function nav(i) { document.querySelectorAll('.page').forEach((p,idx) => p.classList.toggle('active', i===idx)); }
    function setTheme(t) { document.getElementById('appBody').className = 'pt-10 px-6 ' + (t==='day' ? '' : 'theme-'+t); }

    const tasks = [
        {d:1,t:"視覺碎形化",i:"換路回家，拍下3個美學細節。"},{d:2,t:"數位減壓",i:"斷網1小時，聽大腦聲音。"},{d:3,t:"窒息點紀錄",i:"分析焦慮的發炎源。"},{d:4,t:"原形冒險",i:"嘗試未吃過的原形食物。"},{d:5,t:"童心拾遺",i:"找回兒時愛好。"},{d:6,t:"抽離練習",i:"第三人稱觀察配色。"},{d:7,t:"視覺排版",i:"整理工作桌面。"},
        {d:8,t:"糖分斷捨離",i:"挑戰整天無糖。"},{d:9,t:"血糖與情緒",i:"記錄飯後一小時心境。"},{d:10,t:"藍光斷電",i:"睡前不滑手機。"},{d:11,t:"動態冥想",i:"把通勤變成身體旅行。"},{d:12,t:"精準補水",i:"喝足體重40倍的水。"},{d:13,t:"優雅說不",i:"練習拒絕邀約。"},{d:14,t:"抗炎美學",i:"做一頓彩色低GI餐。"},
        {d:15,t:"亮點掃描",i:"回想去年發光時刻。"},{d:16,t:"無限制假設",i:"金錢不是問題要做什麼？"},{d:17,t:"靈數對話",i:"分析5號人特質。"},{d:18,t:"他人之鏡",i:"詢問好友你的閃光點。"},{d:19,t:"提案思維",i:"優化討厭的雜事。"},{d:20,t:"靈感寶庫",i:"收集10張自由意象圖。"},{d:21,t:"三年劇本",i:"寫下三年後的早晨。"},{d:22,t:"撕掉標籤",i:"刪除社會標籤。"},
        {d:23,t:"勇敢發聲",i:"分享你對自由的真實看法。"},{d:24,t:"職能重構",i:"結合美感與健康事業。"},{d:25,t:"浪漫儀式",i:"為瑣事設計高級儀式。"},{d:26,t:"財務自由拆解",i:"規劃副業目標。"},{d:27,t:"跨界連結",i:"傳訊給欣賞的創作者。"},{d:28,t:"碎片化冒險",i:"去新區域工作。"},{d:29,t:"實驗結案",i:"檢視身體發炎感。"},{d:30,t:"重新定義",i:"宣告新身分。"}
    ];

    function renderTasks() {
        const c = document.getElementById('taskContainer');
        const stages = [
            {t:"第一階段：覺察—打破屍態", s:0, e:7}, {t:"第二階段：實驗—抗炎計畫", s:7, e:14},
            {t:"第三階段：定義—人生設計師", s:14, e:22}, {t:"第四階段：實踐—自由定義", s:22, e:30}
        ];
        stages.forEach(st => {
            c.innerHTML += `<h2 class="text-lg font-bold text-[#8E7E6E] mt-10">${st.t}</h2>`;
            tasks.slice(st.s, st.e).forEach(x => {
                c.innerHTML += `<div class="glass p-5 rounded-[24px]"><div class="flex items-center gap-3"><input type="checkbox" class="chk"><span class="text-sm font-bold">Day ${x.d}｜${x.t}</span></div><p class="text-[12px] opacity-70 ml-9 mt-1">${x.i}</p><textarea class="w-full bg-transparent border-b p-2 mt-2 text-xs italic" placeholder="筆記紀錄..."></textarea></div>`;
            });
        });
    }

    // 恢復日記功能
    let currentImg = "";
    document.getElementById('imgIn').onchange = (e) => {
        const reader = new FileReader();
        reader.onload = (ev) => currentImg = ev.target.result;
        reader.readAsDataURL(e.target.files[0]);
    };

    function saveD() {
        const v = document.getElementById('dInput').value; if(!v) return;
        const h = JSON.parse(localStorage.getItem('logs')||'[]');
        h.unshift({v, img: currentImg, d:new Date().toLocaleDateString()});
        localStorage.setItem('logs', JSON.stringify(h));
        currentImg = ""; document.getElementById('dInput').value=''; renderLogs();
    }
    function renderLogs() { document.getElementById('dList').innerHTML = JSON.parse(localStorage.getItem('logs')||'[]').map(x => `<div class="glass p-6 rounded-[24px] mb-4">${x.img ? `<img src="${x.img}" class="rounded-xl mb-3">` : ''}<p class="text-sm">${x.v}</p></div>`).join(''); }

    renderTasks(); renderLogs();
</script>
</body>
</html>
